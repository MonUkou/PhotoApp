<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="18dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="18dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Chi tiết người dùng"
          android:textColor="#172B4D"
          android:textSize="24sp"
          android:textStyle="bold"/>

    </LinearLayout>


    <!-- AVATAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="18dp">

      <ImageView
          android:id="@+id/iv_detail_avatar"
          android:layout_width="170dp"
          android:layout_height="170dp"
          android:background="#FFFFFF"
          android:padding="4dp"
          android:scaleType="centerCrop"
          android:src="@android:drawable/ic_menu_myplaces"
          android:contentDescription="Ảnh đại diện"/>

      <ProgressBar
          android:id="@+id/progress_avatar"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="150dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:max="100"
          android:indeterminate="true"/>

    </LinearLayout>


    <!-- USER INFORMATION CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="18dp"
        android:elevation="3dp"
        android:layout_marginBottom="14dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="THÔNG TIN TÀI KHOẢN"
          android:textColor="#64748B"
          android:textSize="12sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"/>

      <TextView
          android:id="@+id/tv_detail_username"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:textColor="#172B4D"
          android:textSize="22sp"
          android:textStyle="bold"/>

      <TextView
          android:id="@+id/tv_detail_email"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="7dp"
          android:textColor="#475569"
          android:textSize="14sp"/>

      <TextView
          android:id="@+id/tv_detail_id"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:textColor="#64748B"
          android:textSize="13sp"/>

    </LinearLayout>


    <!-- DESCRIPTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="18dp"
        android:elevation="2dp"
        android:layout_marginBottom="14dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="GIỚI THIỆU"
          android:textColor="#172B4D"
          android:textSize="15sp"
          android:textStyle="bold"/>

      <TextView
          android:id="@+id/tv_detail_desc"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="9dp"
          android:textColor="#475569"
          android:textSize="14sp"
          android:lineSpacingExtra="3dp"/>

    </LinearLayout>


    <!-- HOBBY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="18dp"
        android:elevation="2dp"
        android:layout_marginBottom="20dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="SỞ THÍCH"
          android:textColor="#172B4D"
          android:textSize="15sp"
          android:textStyle="bold"/>

      <TextView
          android:id="@+id/tv_detail_hobby"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="9dp"
          android:textColor="#475569"
          android:textSize="14sp"
          android:lineSpacingExtra="3dp"/>

    </LinearLayout>


    <!-- BACK BUTTON -->
    <Button
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="QUAY LẠI"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6200EE"/>

  </LinearLayout>

</ScrollView>